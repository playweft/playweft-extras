{
  "name": "playweft-extras",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Creative multiplayer game experiments for Playweft.",
  "scripts": {
    "dev": "vite",
    "dev:light-trails": "node scripts/dev.mjs",
    "dev:bubble-mischief-crew": "DEV_GAME=bubble-mischief-crew node scripts/dev.mjs",
    "dev:bubble-kick": "npm run dev:bubble-mischief-crew",
    "build": "vite build",
    "check": "vite build --emptyOutDir && node --test tests/*.test.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.6",
    "happy-dom": "21.0.3",
    "vite": "8.1.5",
    "wasmoon": "1.16.0",
    "ws": "8.18.3"
  },
  "dependencies": {
    "lucide-preact": "1.59.0",
    "preact": "11.0.1"
  }
}
