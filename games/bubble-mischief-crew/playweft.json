{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifest_version": 1,
  "id": "/bubble-kick/",
  "version": "1.9.1",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "start_url": "./",
  "launch_mode": "choose",
  "name": "Bubble Mischief Crew",
  "name_localized": {
    "zh-CN": "泡泡捣蛋团"
  },
  "description": "Round up your friends for playful bubble chaos. Kick ticking bubbles, dodge chain reactions, and rescue teammates in Bubble Football.",
  "description_localized": {
    "zh-CN": "叫上朋友，一起捣蛋、互相救场。当前提供泡泡足球，支持单人练习、同屏双人与 2–4 人联机。"
  },
  "categories": ["games", "arcade"],
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#000000",
  "theme_color": "#000000",
  "help_url": "./help.html",
  "modes": {
    "solo": {},
    "room": {
      "players": {
        "min": 2,
        "max": 4
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "live"
      }
    }
  },
  "orientation": "landscape"
}
